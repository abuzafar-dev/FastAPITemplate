# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Required ---------------------------------------------------------------
# Generate a fresh one — never reuse a key from a tutorial or another project:
#     openssl rand -hex 32
SECRET_KEY=change-me-run-openssl-rand-hex-32

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# --- Redis: stores pending registrations and their OTP codes -----------------
REDIS_URL=redis://localhost:6379/0

# --- SMTP: sends the registration OTP ---------------------------------------
# Optional: the app starts without them, but sending an OTP will fail.
# For Gmail this must be an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
